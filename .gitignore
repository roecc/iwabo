# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# make exclusion exception for inklecate
!unreal/Plugins/Inkpot/ThirdParty/InkCommandLine/*.exe
!unreal/Plugins/Inkpot/ThirdParty/InkCommandLine/*.dll
!iwabo/Plugins/Inkpot/ThirdParty/InkCommandLine/*.exe
!iwabo/Plugins/Inkpot/ThirdParty/InkCommandLine/*.dll

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
unreal/SourceArt/**/*.png
Iwabo/SourceArt/**/*.png
SourceArt/**/*.tga
unreal/SourceArt/**/*.tga
iwabo/SourceArt/**/*.tga

# Binary Files
Binaries/*
unreal/Binaries/*
iwabo/Binaries/*
Plugins/**/Binaries/*
unreal/Plugins/**/Binaries/*
iwabo/Plugins/**/Binaries/*

# Builds
Build/*
unreal/Build/*
iwabo/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
unreal/!Build/*/
iwabo/!Build/*/
Build/*/**
unreal/Build/*/**
iwabo/Build/*/**
!Build/*/PakBlacklist*.txt
unreal/!Build/*/PakBlacklist*.txt
iwabo/!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico
unreal/!Build/**/*.ico
iwabo/!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset
unreal/*_BuiltData.uasset
iwabo/*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*
unreal/Saved/*
iwabo/Saved/*

# Compiled source files for the engine to use
Intermediate/*
unreal/Intermediate/*
iwabo/Intermediate/*
Plugins/**/Intermediate/*
unreal/Plugins/**/Intermediate/*
iwabo/Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
unreal/DerivedDataCache/*
iwabo/DerivedDataCache/*

# Bought Asset Library
unreal/Content/ThirdParty/TMPAssetPacks/*

# Large .blend file
Blender/Titan1 Blockout/Titan1Blockout.blend
Blender/Titan1 Blockout/Titan1Blockout.blend1
Blender/MaryAnn_MetaHuman_Test/MaryAnn_MetaHuman_Test.blend
Blender/MaryAnn_MetaHuman_Test/MaryAnn_MetaHuman_Test.blend1
