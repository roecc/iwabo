			"y":340,
			"width":260,
			"height":60
		},
		{
			"id":"153a440f84c20df3",
			"type":"text",
			"text":"",
			"styleAttributes":{"shape":"parallelogram"},
			"x":11000,
			"y":100,
			"width":260,
			"height":60
		},
		{
			"id":"557d19fa73e21f24",
			"type":"text",
			"text":"need at least 1 garden >=damaged at any time (fish)",
			"styleAttributes":{},
			"x":10760,
			"y":960,
			"width":260,
			"height":60
		},
		{
			"id":"d461d3749e9c2665",
			"type":"text",
			"text":"if >=maintained, garden damaged -> fine",
			"styleAttributes":{},
			"x":10780,
			"y":740,
			"width":260,
			"height":60
		},
		{
			"id":"0dfed6298cc3bf74",
			"type":"text",
			"text":"high maintain = low chance break",
			"styleAttributes":{},
			"x":10300,
			"y":60,
			"width":260,
			"height":60
		},
		{
			"id":"e7aaef1d49ce8dc9",
			"type":"text",
			"text":"Conserves / Fresh morale",
			"styleAttributes":{},
			"x":10300,
			"y":140,
			"width":260,
			"height":60
		},
		{
			"id":"7bdd26d261d7e3cd",
			"type":"text",
			"text":"need at least 1 garden >=damaged at any time (fish)",
			"styleAttributes":{},
			"x":10300,
			"y":380,
			"width":260,
			"height":60
		},
		{
			"id":"b9037008fbcad730",
			"type":"text",
			"text":"if >=maintained, garden damaged -> fine",
			"styleAttributes":{},
			"x":10300,
			"y":500,
			"width":260,
			"height":60
		},
		{
			"id":"fd34474dbd2f6d7e",
			"type":"text",
			"text":"if a unit breaks or isn't on, the fish and plants will die.\nsince we can't  go out to get more, if we lose all fish (by all every unit being either off or broken) we lose the farm.\nso at least one unit has to be kept running at all times.",
			"styleAttributes":{},
			"x":7880,
			"y":1000,
			"width":440,
			"height":160
		},
		{
			"id":"944ef8f1799b64a2",
			"type":"text",
			"text":"this is a living system. so we can't just fasten some bolts and call it fixed. but it will heal if we keep it at least maintained for a while.",
			"styleAttributes":{},
			"x":7880,
			"y":1180,
			"width":440,
			"height":120
		},
		{
			"id":"496c90e4bfbb682e",
			"type":"text",
			"text":"we also can't turn it off without killing the fish and plants.",
			"styleAttributes":{},
			"x":7880,
			"y":1340,
			"width":440,
			"height":60
		},
		{
			"id":"4714c66f39e510fb",
			"type":"text",
			"text":"the better shape a unit is in, the more food it will produce.",
			"styleAttributes":{},
			"x":7880,
			"y":1420,
			"width":440,
			"height":80
		},
		{
			"id":"2d77dc2d6363cb12",
			"type":"text",
			"text":"healing",
			"styleAttributes":{},
			"x":7720,
			"y":1180,
			"width":160,
			"height":60
		},
		{
			"id":"8e9e03f64faaa8ea",
			"type":"text",
			"text":"First, let's take a look at our generator.\n(inspect)\nthe maintenance will always wear down over time, the longer we neglect it the more work it will take to make it run smoothly again, and the more likely it is to be first damaged and eventually break completely.\n",
			"styleAttributes":{},
			"x":7880,
			"y":120,
			"width":440,
			"height":200
		},
		{
			"id":"2d4178f0da33c38d",
			"type":"text",
			"text":"two parts",
			"styleAttributes":{},
			"x":7720,
			"y":340,
			"width":160,
			"height":60
		},
		{
			"id":"173b2c8fcbe68071",
			"type":"text",
			"text":"each unit is made of two parts, a fish tank and a growing vat\nthe fish feed the plants, the plants clean the water",
			"styleAttributes":{},
			"x":7880,
			"y":340,
			"width":440,
			"height":120
		},
		{
			"id":"9c03df5e930e7afc",
			"type":"text",
			"text":"why grow",
			"styleAttributes":{},
			"x":7720,
			"y":460,
			"width":160,
			"height":60
		},
		{
			"id":"fb30a574005792d2",
			"type":"text",
			"text":"Every day we eat some of it. And eventually it will run out.\nWe have a lot of food stocked up, but that will run out eventually. Growing our own will stretch our reserves and who knows? We might even manage to become self-sufficient.",
			"styleAttributes":{},
			"x":7880,
			"y":460,
			"width":440,
			"height":160
		},
		{
			"id":"d3bb9ca4fbf09d4f",
			"type":"text",
			"text":"we need to maintain that balance.",
			"styleAttributes":{},
			"x":7880,
			"y":720,
			"width":440,
			"height":60
		},
		{
			"id":"abeb6ca1df3a9a22",
			"type":"text",
			"text":"maintain",
			"styleAttributes":{},
			"x":7720,
			"y":720,
			"width":160,
			"height":60
		},
		{
			"id":"6e6d340596a75e63",
			"type":"text",
			"text":"aquapnics are complex mini eco-systems.\nthey need to be closely watched and controlled.\n(inspect)",
			"styleAttributes":{},
			"x":7880,
			"y":780,
			"width":440,
			"height":120
		},
		{
			"id":"0dd0b05dd403ae77",
			"type":"text",
			"text":"every lesson with example",
			"styleAttributes":{},
			"x":8280,
			"y":-100,
			"width":260,
			"height":60,
			"color":"6"
		},
		{
			"id":"007057fd6290a145",
			"type":"text",
			"text":"J:the farm is where we get all our fresh food.\nJ:but erm- why not just canned?\n",
			"styleAttributes":{},
			"x":7920,
			"y":620,
			"width":440,
			"height":80
		},
		{
			"id":"47eeff5392e145be",
			"type":"text",
			"text":"They need power for the water pumps and grow-lights. ",
			"styleAttributes":{"shape":"parallelogram"},
			"x":7040,
			"y":480,
			"width":260,
			"height":60
		},
		{
			"id":"3fa073e2f8646240",
			"type":"text",
			"text":"Without them the system collapses.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":7080,
			"y":540,
			"width":260,
			"height":60
		},
		{
			"id":"9e2bfe632b1a35af",
			"type":"text",
			"text":"The plants and fish would die.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":7080,
			"y":600,
			"width":260,
			"height":60
		},
		{
			"id":"27d01450a5a370ee",
			"type":"text",
			"text":"Look here, this unit didn't have enough power.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":6880,
			"y":920,
			"width":260,
			"height":60
		},
		{
			"id":"1070c4a81a8ef79c",
			"type":"text",
			"text":"Only as long as we have at least one active unit somewhere.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":6940,
			"y":1060,
			"width":280,
			"height":60
		},
		{
			"id":"fb0252a33a5c7db2",
			"type":"text",
			"text":"Yes, but it takes time.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":6940,
			"y":1120,
			"width":280,
			"height":60
		},
		{
			"id":"045c7fb8d6df1dac",
			"type":"text",
			"text":"Can we fix it?",
			"styleAttributes":{},
			"x":7100,
			"y":1000,
			"width":260,
			"height":60
		},
		{
			"id":"eba15b7ae5dc5c55",
			"type":"text",
			"text":"We can only restart it.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":6940,
			"y":1240,
			"width":280,
			"height":60
		},
		{
			"id":"dc6932eee03331d7",
			"type":"text",
			"text":"You can't fix death.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":6940,
			"y":1300,
			"width":280,
			"height":60
		},
		{
			"id":"9154d0c5e3ae12db",
			"type":"text",
			"text":"Because we need to take the fish from somewhere before we can breed them.",
			"styleAttributes":{"shape":"parallelogram"},
			"x":7000,
			"y":1440,
			"width":320,
			"height":60
		},
		{
			"id":"3c45d134a9ec1726",
			"type":"text",
			"text":"Why?",
			"styleAttributes":{},
			"x":7140,
			"y":1380,
			"width":260,
			"height":60
		},
		{
			"id":"326018dfa8656c1c",
