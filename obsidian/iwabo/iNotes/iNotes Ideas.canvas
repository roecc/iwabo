			"styleAttributes":{},
			"x":-500,
			"y":1880,
			"width":260,
			"height":60
		},
		{
			"id":"6379d8dad2fdba94",
			"type":"text",
			"text":"Art",
			"styleAttributes":{},
			"x":-500,
			"y":1960,
			"width":260,
			"height":60
		},
		{
			"id":"1a8772dff631185c",
			"type":"text",
			"text":"Making a Living / Living Wage",
			"styleAttributes":{},
			"x":-780,
			"y":1940,
			"width":260,
			"height":60
		},
		{
			"id":"e3183dd9b09473e2",
			"type":"text",
			"text":"Applied Philosophy\n(why care what old farts said?)",
			"styleAttributes":{},
			"x":-780,
			"y":2020,
			"width":260,
			"height":60
		},
		{
			"id":"c362e3a2cfffca23",
