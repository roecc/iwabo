			"styleAttributes":{},
			"x":-500,
			"y":1800,
			"width":260,
			"height":60
		},
		{
			"id":"d5c3663dbab93cea",
			"type":"text",
			"text":"Borrowed Cognition",
			"styleAttributes":{},
			"x":-780,
			"y":1780,
			"width":260,
			"height":60
		},
		{
			"id":"ffcbb05f3bf4ccbf",
			"type":"text",
			"text":"(Cost of living) How much it really takes to live",
			"styleAttributes":{},
			"x":-780,
			"y":1860,
			"width":260,
			"height":60
		},
		{
			"id":"95a04b203f5d6cec",
