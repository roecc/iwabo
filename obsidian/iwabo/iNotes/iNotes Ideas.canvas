			"text":"About actively paying attention and thinking critically",
			"styleAttributes":{},
			"x":-220,
			"y":2440,
			"width":260,
			"height":80
		},
		{
			"id":"4938c998a8f2aa5d",
			"type":"text",
			"text":"And what could happen if you dont.",
