			"y":900,
			"width":260,
			"height":300
		},
		{
			"id":"da725c81c01a1fa0",
			"type":"text",
			"text":"Inhuman optimization",
			"styleAttributes":{},
			"x":-500,
			"y":3320,
			"width":260,
			"height":60
		},
		{
			"id":"75bec8bf5ddf9127",
			"type":"text",
			"text":"[https://youtu.be/YAmzlB40hZs?si=93SzoI9bcGzsPs1S](https://youtu.be/YAmzlB40hZs?si=93SzoI9bcGzsPs1S)",
			"styleAttributes":{},
			"x":180,
			"y":3500,
			"width":260,
			"height":60
		},
		{
			"id":"850ec6019803b7d1",
			"type":"text",
			"text":"Shabbat mode",
			"styleAttributes":{},
			"x":1680,
			"y":800,
			"width":260,
			"height":60
		},
		{
			"id":"0ce6c79a7ea3415f",
			"type":"text",
			"text":"Song\nGeneral ordering her troops but they run\nWho’s at fault?\nCowards or tyrant?",
			"styleAttributes":{},
			"x":-2380,
			"y":500,
			"width":260,
			"height":140
		},
		{
			"id":"ad23a2b4d6dc5e21",
			"type":"text",
			"text":"Yelling at people doesn’t change their minds\nWhat else am I going to do?\nSo to feel good about yourself?\n\n",
			"styleAttributes":{},
			"x":560,
			"y":-920,
			"width":260,
			"height":120
		},
		{
			"id":"c7a03556a4237d2d",
			"type":"text",
			"text":"It doesn’t need to be perfect. It doesn’t even have to be right to work.\n\nIt just has to be meaningful",
			"styleAttributes":{},
			"x":560,
			"y":-780,
			"width":260,
			"height":160
		},
		{
			"id":"ff3494a4037d6699",
			"type":"text",
			"text":"Art as Map",
			"styleAttributes":{},
			"x":-780,
			"y":3560,
			"width":260,
			"height":60
		},
		{
			"id":"50d7ff0ab3063767",
			"type":"text",
			"text":"Art as Shadow",
			"styleAttributes":{},
			"x":-780,
			"y":3640,
			"width":260,
			"height":60
		},
		{
			"id":"abb61613479d9312",
			"type":"text",
			"text":"Art as Vessel (filled with meaning)",
			"styleAttributes":{},
			"x":-780,
			"y":3720,
			"width":260,
			"height":60
		},
		{
			"id":"b70dece77e0c3232",
			"type":"text",
			"text":"Bellmans Map",
			"styleAttributes":{},
			"x":180,
			"y":3580,
			"width":260,
			"height":60
		},
		{
			"id":"81b5b0894dbe2dee",
			"type":"text",
			"text":"Platos Cave",
			"styleAttributes":{},
			"x":180,
			"y":3660,
			"width":260,
			"height":60
		},
		{
			"id":"3036eb635b7638c5",
			"type":"text",
			"text":"Necessary Nuisance",
			"styleAttributes":{},
			"x":-500,
			"y":3400,
			"width":260,
			"height":60
		},
		{
			"id":"b4c9e68298b58104",
			"type":"text",
			"text":"**bombraid prelude**\n\nNuclear family\nMorale bombing\nIneffective but manly",
			"styleAttributes":{},
			"x":1200,
			"y":-1160,
			"width":260,
			"height":140
		},
		{
			"id":"b7e0d6532dd18ac7",
			"type":"text",
			"text":"House of dynamite movie",
			"styleAttributes":{},
			"x":180,
			"y":3740,
			"width":260,
			"height":60
		},
		{
			"id":"8fda5141a4a49076",
			"type":"text",
			"text":"**Doing what’s necessary to protect one’s own**",
			"styleAttributes":{},
			"x":-500,
			"y":3480,
			"width":260,
			"height":60
		},
		{
			"id":"1b4446ab5a1b8202",
			"type":"text",
			"text":"Believers trying to outdo eachother",
			"styleAttributes":{},
			"x":-780,
			"y":3800,
			"width":260,
			"height":60
		},
		{
			"id":"edb5974bc15822fa",
			"type":"text",
			"text":"Babel: gate to god",
			"styleAttributes":{},
			"x":180,
			"y":3820,
			"width":260,
			"height":60
		},
		{
			"id":"55e5e9148d2243fe",
			"type":"text",
			"text":"Believability is certainly a large part of writing but it’s not its end point\nJust bc something reasonably could happen doesn’t mean that it should or is good to have happened.",
			"styleAttributes":{},
			"x":-2100,
			"y":500,
			"width":260,
			"height":200
		},
		{
			"id":"84ba6c49a2aa9eb7",
			"type":"text",
			"text":"Blind Certainty \nAnd consequence?",
			"styleAttributes":{},
			"x":-220,
			"y":3280,
			"width":260,
			"height":60
		},
		{
			"id":"233ce47139a8039e",
			"type":"text",
			"text":"**Morale cost to unlearning**\nSit down and entertain the idea the world might still be there, it might be safe to go out\n\nAll the things you’ve done to stay here. It hurts to think about. you want to avoid it wherever possible even if you already know",
			"styleAttributes":{},
			"x":1680,
			"y":880,
			"width":260,
			"height":260
		},
		{
			"id":"cd594995bb2eda3f",
			"type":"text",
			"text":"Rubber banding:\nFail upkeep, morale goes down, preaching it’s necessary and prudent bc world will kill you, morale back up",
			"styleAttributes":{},
			"x":1960,
			"y":1220,
			"width":260,
			"height":140
		},
		{
			"id":"38560f26a90fc4f1",
			"type":"text",
			"text":"Ufff",
			"styleAttributes":{},
			"x":2880,
			"y":1120,
			"width":260,
			"height":60
		},
		{
			"id":"c21772c711c77d29",
			"type":"text",
			"text":"Re-Set PC? Lots of Hassle but should do eventually anyway?",
			"styleAttributes":{},
			"x":2920,
			"y":1200,
			"width":260,
			"height":60
		},
		{
			"id":"d8ec9838fd65863d",
			"type":"text",
			"text":"Check Steam Lib Compatibility w/ Linux",
			"styleAttributes":{},
			"x":2920,
			"y":1280,
			"width":260,
			"height":60
		},
		{
			"id":"4a31f4a8fc6e9cf4",
			"type":"text",
			"text":"Scripture as control, morale and \n\nCheck the most popular pro big",
			"styleAttributes":{},
			"x":-220,
			"y":3360,
			"width":260,
			"height":140
		},
		{
			"id":"05fbe09d74a81370",
			"type":"text",
			"text":"Poking fun at forced masculinity",
			"styleAttributes":{},
			"x":-220,
			"y":3520,
			"width":260,
			"height":60
		},
		{
			"id":"add4474ff9d999d8",
			"type":"text",
			"text":"Low libido",
			"styleAttributes":{},
			"x":1680,
			"y":1160,
			"width":260,
			"height":60
		},
		{
			"id":"78ea4aff4e7751b6",
			"type":"text",
			"text":"Fridge Drawing\nLow perception -> no mood- -",
			"styleAttributes":{},
			"x":2580,
			"y":300,
			"width":260,
			"height":60
		},
		{
			"id":"50c1bc16c7dc07e3",
			"type":"text",
			"text":"I like computers\nYou can just fix it if it misunderstands you\nPeople cling to the mistakes",
			"styleAttributes":{},
			"x":840,
			"y":-1480,
			"width":260,
			"height":120
		},
		{
			"id":"14a2a280e97a90f3",
			"type":"text",
			"text":"Mechanic",
			"styleAttributes":{},
			"x":1800,
			"y":-1600,
			"width":260,
			"height":60
		},
		{
			"id":"35b2cd96e0f1cda6",
			"type":"text",
			"text":"About truths taken for granted",
			"styleAttributes":{},
			"x":-500,
			"y":3560,
			"width":260,
			"height":60
		},
		{
			"id":"f2ec5df0c0dd2268",
			"type":"text",
			"text":"Being certain, and being wrong, and potential consequences of being both.",
			"styleAttributes":{},
			"x":-500,
			"y":3640,
			"width":260,
			"height":100
		},
		{
			"id":"e38516635f3cb961",
			"type":"text",
			"text":"Work expectations eating all time and energy, none left over for the hard work of self examination.\n\n> resource management, AP",
			"styleAttributes":{},
			"x":1680,
			"y":1240,
			"width":260,
			"height":180
		},
		{
			"id":"aa904cf1cd3b4134",
			"type":"text",
			"text":"\"i dont want to\" -> AP cost++",
			"styleAttributes":{},
			"x":1680,
			"y":1440,
			"width":260,
			"height":60
		},
		{
			"id":"dcc204e510dcccba",
			"type":"text",
			"text":"This is a family, not a democracy -> avatar 3",
			"styleAttributes":{},
			"x":520,
			"y":1740,
			"width":260,
			"height":60
		},
		{
			"id":"7360e07e85f6d474",
			"type":"text",
			"text":"Intelligence / arrogance",
			"styleAttributes":{},
			"x":840,
			"y":-260,
			"width":260,
			"height":60
		},
		{
			"id":"5da09f50e151a3d0",
			"type":"text",
			"text":"Fetishization of “hard choices”",
			"styleAttributes":{},
			"x":-500,
			"y":3760,
			"width":260,
			"height":60
		},
		{
			"id":"7af2702eefc16746",
			"type":"text",
			"text":"Erasure is not equality",
			"styleAttributes":{},
			"x":-2380,
			"y":660,
			"width":260,
			"height":60
		},
		{
			"id":"4582ae49939d641b",
			"type":"text",
			"text":"Scientism\nFuturism\nProgressivism\nScientific Racism",
			"styleAttributes":{},
			"x":180,
			"y":3900,
			"width":260,
			"height":120
		},
		{
			"id":"ca7c3c2cc39ebe02",
			"type":"text",
			"text":"Uncomfortable questions ",
			"styleAttributes":{},
			"x":-500,
			"y":3840,
			"width":260,
			"height":60
		},
		{
			"id":"948696871e40a934",
			"type":"text",
			"text":"Will listen to racism but not reason",
			"styleAttributes":{},
			"x":-2380,
			"y":740,
			"width":260,
			"height":60
		},
		{
			"id":"2ec46ea10e7ea9c5",
			"type":"text",
			"text":"[https://open.spotify.com/episode/6r8F8lAEBlAVYirhZrxYGM?si=9FP2oDhGQN6xBgRikKBVKw&t=1343&ct=1212](https://open.spotify.com/episode/6r8F8lAEBlAVYirhZrxYGM?si=9FP2oDhGQN6xBgRikKBVKw&t=1343&ct=1212)",
			"styleAttributes":{},
			"x":180,
			"y":4040,
			"width":260,
			"height":60
		},
		{
			"id":"0e88da403027ed99",
			"type":"text",
			"text":"Steal Hard-Coded progression?\n\nStory interaction passes the day\n\nActionpoints limit non-story interactions?",
			"styleAttributes":{},
			"x":2240,
			"y":1060,
			"width":260,
			"height":60
		},
		{
			"id":"d18d8d9a419e71fb",
