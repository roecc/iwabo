		},
		{
			"id":"ffcbb05f3bf4ccbf",
			"type":"text",
			"text":"(Cost of living) How much it really takes to live",
			"styleAttributes":{},
			"x":-780,
			"y":1860,
			"width":260,
			"height":60
		},
		{
			"id":"1a8772dff631185c",
