			"text":"[One Chance](https://www.newgrounds.com/portal/view/555181)",
			"styleAttributes":{},
			"x":180,
			"y":920,
			"width":260,
			"height":60
		},
		{
			"id":"69c319a2f9c95d34",
			"type":"text",
			"text":"Homeschooling -> save children from the evil secular world.\n\n“They had a plan for women, we didn’t. That’s why they’re winning”\n\nParrallel to men and Tate?",
			"styleAttributes":{},
			"x":-500,
			"y":960,
			"width":260,
			"height":240
		},
		{
			"id":"549625d9b7e3557d",
			"type":"text",
			"text":"moral majority\nex: Abortion wasn’t always a contentious issue",
			"styleAttributes":{},
			"x":-220,
			"y":980,
			"width":260,
			"height":100
		},
		{
			"id":"120783fa6f27fc49",
			"type":"text",
			"text":"[I Was a Teenage Exocolonist](https://app.sensortower.com/vgi/game/i-was-a-teenage-exocolonist)",
			"styleAttributes":{},
			"x":180,
			"y":1000,
			"width":260,
			"height":60
		},
		{
			"id":"1f4b4f10e255500b",
			"type":"text",
			"text":"\"Meet them where they are\"\n->Bikers/Skaters for Christ",
			"styleAttributes":{},
			"x":-220,
			"y":1100,
			"width":260,
			"height":60
		},
		{
			"id":"a1e4d050ade8486b",
			"type":"text",
			"text":"Modern Notes",
			"styleAttributes":{},
			"x":760,
			"y":1100,
			"width":260,
