			"width":260,
			"height":60
		},
		{
			"id":"c362e3a2cfffca23",
			"type":"text",
			"text":"Stories/story telling",
			"styleAttributes":{},
			"x":-500,
			"y":2040,
			"width":260,
			"height":60
		},
		{
			"id":"25cddac6d1178238",
			"type":"text",
			"text":"Only certain people get to heaven\n\nOnly certain people will survive",
			"styleAttributes":{},
			"x":-500,
			"y":2120,
			"width":260,
			"height":120
		},
		{
			"id":"168d1a3a60604fd2",
			"type":"text",
			"text":"**Rand objectivism**\nAyn Rand\n\nRational Animal\nEthics are self defense?\nMorality function is to ensure long term survival\nTrichotomy- intrinsic (Kant, thing itself)/subjective/objective\nReality is an objective absolute\n(Acts don’t care about your feelings)\nIf thinking rationally enough, everyone agrees\nTruly rational being would not use people as means to an end\nWould not self sacrifice\n\nNeed laissez faire capitalism!\nPursuing own rational self interest\nEssentialism/",
			"styleAttributes":{},
			"x":-780,
			"y":2260,
			"width":540,
			"height":400
		},
		{
			"id":"943545383b2b58d0",
			"type":"text",
			"text":"Logic vs Emotion\n(Logic should and has to include emotion)",
			"styleAttributes":{},
			"x":-220,
			"y":2260,
			"width":260,
			"height":80
		},
		{
			"id":"0b0377215a5e6255",
			"type":"text",
			"text":"About actively paying attention and thinking critically",
			"styleAttributes":{},
			"x":-220,
			"y":2440,
			"width":260,
			"height":80
		},
		{
			"id":"4938c998a8f2aa5d",
			"type":"text",
			"text":"And what could happen if you dont.",
			"styleAttributes":{},
			"x":-220,
			"y":2540,
			"width":260,
			"height":60
		},
		{
			"id":"edad5c689bdedaca",
			"type":"text",
			"text":"A game about being trapped by your own perspective / self",
			"styleAttributes":{},
			"x":-220,
			"y":2620,
			"width":260,
			"height":60
		},
		{
			"id":"1f06dd2a113c6f9a",
			"type":"text",
			"text":"Self-Reliance, Selfishness",
			"styleAttributes":{},
			"x":-500,
			"y":2680,
			"width":260,
			"height":60
		},
		{
			"id":"97955d9f19a4ce3a",
			"type":"text",
			"text":"Escape the apocalypse \nYour presumptions",
			"styleAttributes":{},
			"x":-220,
			"y":2700,
			"width":260,
			"height":60
		},
		{
			"id":"949361115c911628",
			"type":"text",
			"text":"Was it selfish on me to be insistent on Self-Reliance?",
			"styleAttributes":{},
			"x":-500,
			"y":2760,
			"width":260,
			"height":60
		},
		{
			"id":"55136be576a8a013",
			"type":"text",
			"text":"Decide: what it takes to be a good man",
			"styleAttributes":{},
			"x":-220,
			"y":2780,
			"width":260,
			"height":60
		},
		{
			"id":"fbef9b2b022363c0",
			"type":"text",
			"text":"How do stories influence how we think?",
			"styleAttributes":{},
			"x":-500,
			"y":2840,
			"width":260,
			"height":60
		},
		{
			"id":"4497115c36f1b689",
			"type":"text",
			"text":"about the kind of men who will respond with nothing but “that guy needs to be murdered” when someone tells them they were assaulted.",
			"styleAttributes":{},
			"x":-220,
			"y":2860,
			"width":260,
			"height":140
		},
		{
			"id":"b04b510a3acaed6b",
