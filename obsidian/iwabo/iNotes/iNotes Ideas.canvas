			"y":720,
			"width":260,
			"height":160
		},
		{
			"id":"f65447d0b5795506",
			"type":"text",
			"text":"Creatures",
			"styleAttributes":{},
			"x":520,
			"y":740,
			"width":260,
			"height":60
		},
		{
			"id":"ffbdde83f9ec9cba",
			"type":"text",
			"text":"Disco Elysium",
			"styleAttributes":{},
			"x":520,
			"y":820,
			"width":260,
			"height":60
		},
		{
			"id":"9f8b28e6eae10159",
			"type":"text",
			"text":"**building a foundation before you know any better. And the disproportionate value we as a society attribute to sticking to it.**",
			"styleAttributes":{},
			"x":-220,
			"y":540,
			"width":260,
			"height":140
		},
		{
			"id":"e7a7183d5b297ca4",
			"type":"text",
			"text":"**Heidegger and dwelling**",
			"styleAttributes":{},
			"x":-220,
			"y":700,
			"width":260,
			"height":60
		},
		{
			"id":"495ade149062d288",
			"type":"text",
			"text":"**Carver clementine dialogue boss battle twd s 2**",
			"styleAttributes":{},
			"x":180,
			"y":680,
			"width":260,
			"height":60
		},
		{
			"id":"dc87991df32a396f",
			"type":"text",
			"text":"Certainty at a cost",
			"styleAttributes":{},
			"x":-780,
			"y":640,
			"width":260,
			"height":60
		},
		{
			"id":"4ebaee4e4165a938",
			"type":"text",
			"text":"What point is served by telling someone they have to apologise?\n\n  \n\nMany of the character driven story beats depend on Daryl’s input. But even the best advice wouldn’t be as essential in shaping them into “good” people, if they had any outside influence whatsoever.",
			"styleAttributes":{},
			"x":-500,
			"y":480,
			"width":260,
			"height":300
		},
		{
			"id":"fa2adbb00d164a6f",
			"type":"text",
			"text":"Bill Gothard\nInstitute to basic life principles",
			"styleAttributes":{},
			"x":180,
			"y":600,
			"width":260,
			"height":60
		},
		{
			"id":"120783fa6f27fc49",
			"type":"text",
			"text":"[I Was a Teenage Exocolonist](https://app.sensortower.com/vgi/game/i-was-a-teenage-exocolonist)",
			"styleAttributes":{},
			"x":520,
			"y":580,
			"width":260,
			"height":60
		},
		{
			"id":"a69cf00328beff3a",
			"type":"text",
			"text":"[Spiritfarer](https://app.sensortower.com/vgi/game/spiritfarer-farewell-edition)",
			"styleAttributes":{},
			"x":520,
			"y":660,
			"width":260,
			"height":60
		},
		{
			"id":"f2bf35a697037258",
			"type":"text",
			"text":"- Assumed authority\n- Consequent responsibility \n- Fear and Failure\n- Family",
			"styleAttributes":{},
			"x":-220,
			"y":400,
			"width":260,
			"height":120
		},
		{
			"id":"89397f60e4408000",
			"type":"text",
			"text":"References",
			"styleAttributes":{},
			"x":160,
			"y":340,
			"width":260,
			"height":60
		},
		{
			"id":"784d8b017920038a",
			"type":"text",
			"text":"Btb Josh Duggar",
			"styleAttributes":{},
			"x":180,
			"y":420,
			"width":260,
			"height":60
		},
		{
			"id":"b4513b8fa529cc9c",
			"type":"text",
			"text":"Culture “war”\n\nQuiverful by [Kathryn Joyce](https://www.amazon.de/-/en/Kathryn-Joyce/e/B001JSBTGG/ref=dp_byline_cont_book_1)",
			"styleAttributes":{},
			"x":180,
			"y":500,
			"width":260,
			"height":80
		},
		{
			"id":"19cb511efb957b20",
			"type":"text",
			"text":"Games",
			"styleAttributes":{},
			"x":460,
			"y":420,
			"width":260,
			"height":60
		},
		{
			"id":"286eda3f56c5428e",
			"type":"text",
			"text":"[One Chance](https://www.newgrounds.com/portal/view/555181)",
			"styleAttributes":{},
			"x":520,
			"y":500,
			"width":260,
			"height":60
		},
		{
			"id":"9d605ce98a8a6a61",
			"type":"text",
			"text":"Add a trigger warning of heavy topics (but where?)",
			"styleAttributes":{},
			"x":-700,
			"y":220,
			"width":260,
			"height":60
		},
		{
			"id":"26ee993a7ffc1231",
			"type":"text",
			"text":"Make unavailable options still visible just greyed out?",
			"styleAttributes":{},
			"x":-420,
			"y":300,
			"width":260,
			"height":60
		},
		{
			"id":"c88db9bae2e816fb",
			"type":"text",
			"text":"Reflection- Narcissim",
			"styleAttributes":{},
			"x":680,
			"y":260,
			"width":260,
			"height":60
		},
		{
			"id":"a5d047ea6d936a61",
			"type":"text",
			"text":"Dumbbells\nYou’re strong and fit and the other things. True alpha.\n\nMaintaining your mass means eating more, spending time exercising and costly equipment. \n\nCan’t pay too much for beauty.",
			"styleAttributes":{},
			"x":400,
			"y":20,
			"width":260,
			"height":260
		},
		{
			"id":"41c5a717d3e43f63",
			"type":"text",
			"text":"Want to do good but can’t. Makes someone else, someone stronger do it for them. Is it their good that’s been done?\n\nI’ve created good where there was none.",
			"styleAttributes":{},
			"x":-780,
			"y":400,
			"width":260,
			"height":220
		},
		{
			"id":"6e89f2a5bf8c3e73",
			"type":"text",
			"text":"Themes / Questions / Philosophy / Concepts",
			"styleAttributes":{},
			"x":-820,
			"y":320,
			"width":260,
			"height":60
		},
		{
			"id":"515aed9087b74054",
			"type":"text",
			"text":"[Perspective Paintings, Religion](https://www.youtube.com/shorts/EN0PHj0P__M)",
			"styleAttributes":{},
			"x":-500,
			"y":400,
			"width":260,
			"height":60
		},
		{
			"id":"60ff1ff8b651a58c",
			"type":"text",
			"text":"Meltdown: flicks of radiation on the screen, a humm, eerie blue light",
			"styleAttributes":{},
			"x":-420,
			"y":180,
			"width":260,
			"height":100
		},
		{
			"id":"bc638ccf16f58510",
			"type":"text",
			"text":"The Daryl Axis\nthe way traits are expressed and what they mean is not absolute but defined by how Daryl understands them.",
			"styleAttributes":{},
			"x":680,
			"y":100,
			"width":260,
			"height":140
		},
		{
			"id":"7cab449332d44b05",
			"type":"text",
			"text":"Go even further?\nif something major happens:\nThe father realises, the marble cracks!",
			"styleAttributes":{},
			"x":-700,
			"y":80,
			"width":260,
			"height":120
		},
		{
			"id":"4fdb446cecf1b3b9",
			"type":"text",
			"text":"Use focus to emphasise \n-> perception\n\n(Hovering a perception check option, the camera autofocuses on whatever the trigger is if its in the scene)",
			"styleAttributes":{},
			"x":-420,
			"y":-40,
			"width":260,
			"height":200
		},
		{
			"id":"1a36f60fdd53b70e",
			"type":"text",
			"text":"**Google search suggestions skill check dialogue way to use foresight limit early**",
			"styleAttributes":{},
			"x":1680,
			"y":700,
			"width":260,
			"height":80
		},
		{
			"id":"850ec6019803b7d1",
			"type":"text",
			"text":"Shabbat mode",
			"styleAttributes":{},
			"x":1680,
			"y":800,
			"width":260,
			"height":60
		},
		{
			"id":"233ce47139a8039e",
			"type":"text",
			"text":"**Morale cost to unlearning**\nSit down and entertain the idea the world might still be there, it might be safe to go out\n\nAll the things you’ve done to stay here. It hurts to think about. you want to avoid it wherever possible even if you already know",
			"styleAttributes":{},
			"x":1680,
			"y":880,
			"width":260,
			"height":260
		},
		{
			"id":"add4474ff9d999d8",
			"type":"text",
			"text":"Low libido",
			"styleAttributes":{},
			"x":1680,
			"y":1160,
			"width":260,
			"height":60
		},
		{
			"id":"e38516635f3cb961",
			"type":"text",
			"text":"Work expectations eating all time and energy, none left over for the hard work of self examination.\n\n> resource management, AP",
			"styleAttributes":{},
			"x":1680,
			"y":1240,
			"width":260,
			"height":180
		},
		{
			"id":"aa904cf1cd3b4134",
			"type":"text",
			"text":"\"i dont want to\" -> AP cost++",
			"styleAttributes":{},
			"x":1680,
			"y":1440,
			"width":260,
			"height":60
		},
		{
			"id":"926a55c9e3b185bd",
			"type":"text",
			"text":"Allergies - can’t eat everything, but hyper aware of ingredients, nutri stats etc",
			"styleAttributes":{},
			"x":1320,
			"y":-180,
			"width":260,
			"height":100
		},
		{
			"id":"e40d77138b8ca439",
			"type":"text",
			"text":"Can you train them to do your bidding? (Reward/punishment)",
			"styleAttributes":{},
			"x":1960,
			"y":740,
			"width":260,
			"height":60
		},
		{
			"id":"689207a614f627e7",
			"type":"text",
			"text":"Shooting range, gun safety (leaving gun lying around)",
			"styleAttributes":{},
			"x":1960,
			"y":820,
			"width":260,
			"height":60
		},
		{
			"id":"19d36f761476c4a9",
			"type":"text",
			"text":" **exploration:**\n\n  \n\nTrying things and being awarded with little stories or parts as well as unique “thoughts” or traits (potentially one of two, similar to deus ex, only complicated further because you get the reward for saying certain things that you might not want to say but want the reward for)",
			"styleAttributes":{},
			"x":1960,
			"y":900,
			"width":260,
			"height":300
		},
		{
			"id":"cd594995bb2eda3f",
			"type":"text",
			"text":"Rubber banding:\nFail upkeep, morale goes down, preaching it’s necessary and prudent bc world will kill you, morale back up",
			"styleAttributes":{},
			"x":1960,
			"y":1220,
			"width":260,
			"height":140
		},
		{
			"id":"d46f47a3b5cadf63",
			"type":"text",
			"text":"Mary Ann doing things when the player doesn’t\nif you dont hit kid, she will. otherwise gives you shit for hitting.\n\nperhaps not a great idea\n\nNot only does it double the work, it diminishes player input on what the story is about\n\nPerhaps they don’t want to engage with that idea\n\nThis could be a good way to “opt in” to those conversations\n\nOn the other hand, if it only comes up if the player does it, the player is auto cast into a position on a conversation they might genuinely want to have?",
			"styleAttributes":{},
			"x":1960,
			"y":1380,
			"width":260,
			"height":540
		},
		{
			"id":"3a3497b930a81450",
			"type":"text",
			"text":"**Try doing Iwabo in bw and with filmgrain and old school lighting?**\n\n(Probably not. But maybe as a speacial event?)",
			"styleAttributes":{},
			"x":-140,
			"y":-420,
			"width":260,
			"height":180
		},
		{
			"id":"469f125057d11bb9",
			"type":"text",
			"text":"Characters have favourite meals",
			"styleAttributes":{},
			"x":1680,
			"y":620,
			"width":260,
			"height":60
		},
		{
			"id":"ac8591b6e8e5d92e",
			"type":"text",
			"text":"Not keeping track of calendar makes it difficult to remember birthdays",
			"styleAttributes":{},
			"x":1960,
			"y":640,
			"width":260,
			"height":80
		},
		{
			"id":"289d32be10014a7a",
			"type":"text",
			"text":"Daryl comes up with stories and fables and myths to explain things or to motivate the kids to do their chores",
			"styleAttributes":{},
			"x":1960,
			"y":280,
			"width":260,
			"height":120
		},
		{
			"id":"7a4eb9c0d463312c",
			"type":"text",
			"text":"Bonuses on skill checks for acting appropriately\n\n-> dominance? -> stand on above them, orate down\n\nIncentivize through interesting camera angles",
			"styleAttributes":{},
			"x":1680,
			"y":300,
			"width":260,
			"height":220
		},
		{
			"id":"12d3e577729b72b9",
			"type":"text",
			"text":"April has a wall full of plants cascading down. However, keeping them alive requires constant power.",
			"styleAttributes":{},
			"x":1960,
			"y":420,
			"width":260,
			"height":120
		},
		{
			"id":"d5fbfe9f1d6a5a6c",
			"type":"text",
			"text":"Add eLiza to the game, for Daryl to talk to?",
			"styleAttributes":{},
			"x":1680,
			"y":540,
			"width":260,
			"height":60
		},
		{
			"id":"b66c391b24d71af6",
			"type":"text",
			"text":"Unlucky - things don’t often go your way. But failure suits you, charming in its of way.",
			"styleAttributes":{},
			"x":1320,
			"y":-300,
			"width":260,
			"height":100
		},
		{
			"id":"a9da0b285eaeb86b",
			"type":"text",
			"text":"Art-Critic",
			"styleAttributes":{},
			"x":1320,
			"y":-60,
			"width":260,
			"height":60
		},
		{
			"id":"abcabc61c3afc523",
			"type":"text",
			"text":"Sales man + art afficionado = art dealer",
			"styleAttributes":{},
			"x":1320,
			"y":20,
			"width":260,
			"height":60
		},
		{
			"id":"2f49a30ea2737c93",
			"type":"text",
			"text":"The player can learn much earlier that the world probably didn’t end, at which point it’s their character they need to build to make him admit it to himself and his family.",
			"styleAttributes":{},
			"x":1680,
			"y":-220,
			"width":260,
			"height":180
		},
		{
			"id":"3625931f07c9157c",
			"type":"text",
			"text":"Maybe resource management doesn’t need to be that big a factor? Look at how Twd s1 handled it. Many small actions have an impact on how characters see Lee. Might this be enough?",
			"styleAttributes":{},
			"x":1960,
			"y":-180,
			"width":260,
			"height":200
		},
		{
			"id":"41bf43e31734dff0",
			"type":"text",
			"text":"Clear mechanics to manipulate \n\nBoth into going to the bunker, but also leaving it.\n\nThe second one is pointed out that Daryl still thinks he’s the he arbiter of what should be done. That his skill gives him the right to decide for others.",
			"styleAttributes":{},
			"x":1680,
			"y":-20,
			"width":260,
			"height":300
		},
		{
			"id":"bc992fd41817927d",
			"type":"text",
			"text":"Emoengine\n\nCharacter expressions should remain consistent between dialogue blocks. Blocks can alter or add nuance. Certain emotional states don’t allow for certain dialogue. Test this!!",
			"styleAttributes":{},
			"x":1960,
			"y":40,
			"width":260,
			"height":220
		},
		{
			"id":"9f02cfd04a74b260",
			"type":"text",
			"text":"Remember / Forget Birthdays etc",
			"styleAttributes":{},
			"x":1960,
			"y":560,
			"width":260,
			"height":60
		},
		{
			"id":"532e754fe74b50d0",
			"type":"text",
			"text":"The way you see the world might change. Same world, different skin. Depending on your choices and worldview this skin could be altered or exchanged.",
			"styleAttributes":{},
			"x":1680,
			"y":-420,
			"width":260,
			"height":180
		},
		{
			"id":"6a07d1c619577494",
			"type":"text",
			"text":"Raise nurture foster",
			"styleAttributes":{},
			"x":960,
			"y":-340,
			"width":260,
			"height":60
		},
		{
			"id":"7360e07e85f6d474",
			"type":"text",
			"text":"Intelligence / arrogance",
			"styleAttributes":{},
			"x":960,
			"y":-260,
			"width":260,
			"height":60
		},
		{
			"id":"6d337dc9daf0b45a",
			"type":"text",
			"text":"Patterns - conspiracy",
			"styleAttributes":{},
			"x":960,
			"y":-180,
			"width":260,
			"height":60
		},
		{
			"id":"4a4fbaebbad62b28",
			"type":"text",
			"text":"**Kinds of skills?\nTrait Types**\nLegislative\nJudicative\nExecutive",
			"styleAttributes":{},
			"x":960,
			"y":-80,
			"width":260,
			"height":140
		},
		{
			"id":"ba7ba863c01221d0",
			"type":"text",
			"text":"Hanging Paintings:\n\nDecoration slots. Discover them by looking around or buying them.",
			"styleAttributes":{},
			"x":1960,
			"y":-340,
			"width":260,
			"height":140
		},
		{
			"id":"277449ec011e93c6",
			"type":"text",
			"text":"**They’re not skills, they’re Harriers skills**\nEmotions as skills?",
			"styleAttributes":{},
			"x":680,
			"y":-100,
			"width":260,
			"height":100
		},
		{
			"id":"a0b1cc0c37b0c734",
			"type":"text",
			"text":"**Divide skills into classic male/female virtues?**",
			"styleAttributes":{},
			"x":680,
			"y":20,
			"width":260,
			"height":60
		},
		{
			"id":"5aa92fc7a84c37e3",
			"type":"text",
			"text":"**Dice - Gambler, +1 on all checks, can see the odds?**",
			"styleAttributes":{},
			"x":400,
			"y":-60,
			"width":260,
			"height":60
		},
		{
			"id":"e99e7492460264a9",
			"type":"text",
			"text":"Consider the groups that would wind up in the bunker, the traits between them, overlaps, differences, use that as basis for the skills/items",
			"styleAttributes":{},
			"x":400,
			"y":-300,
			"width":260,
			"height":140
		},
		{
			"id":"78515ed3d9826e25",
			"type":"text",
			"text":"Skills:\nIntrusive thoughts",
			"styleAttributes":{},
			"x":400,
			"y":-140,
			"width":260,
			"height":60
		},
		{
			"id":"61be34423156b3f6",
			"type":"text",
			"text":"Paranoia - Foresight +\n\nActing in character rewarded different from against character (growth)",
			"styleAttributes":{},
			"x":680,
			"y":-420,
			"width":260,
			"height":140
		},
		{
			"id":"534d905554fd7b5d",
			"type":"text",
			"text":"Curiosity (as a learnable skill)",
			"styleAttributes":{},
			"x":680,
			"y":-260,
			"width":260,
			"height":60
		},
		{
			"id":"a385a299b8f8f8d5",
			"type":"text",
			"text":"Morale",
			"styleAttributes":{},
			"x":40,
			"y":-140,
			"width":260,
			"height":60
		},
		{
			"id":"fcff41e5e11fa2e9",
			"type":"text",
			"text":"Rim world mood buffs, adding up, trigger rolls.",
			"styleAttributes":{},
			"x":80,
			"y":-60,
			"width":260,
			"height":60
		},
		{
			"id":"30f7b4758debd41e",
			"type":"text",
			"text":"The main menu is a fridge with child drawings etc?\nThe fridge represents the need to conserve and coldness it takes to do what’s necessary. The family is put front and center yet feels tacked on and somewhat shallow. The food inside, over time, turns.",
			"styleAttributes":{},
			"x":-700,
			"y":-340,
			"width":260,
			"height":240
		},
		{
			"id":"f8237c74da98e94b",
			"type":"text",
			"text":"Use marble sculpture?\n\nReligious connotation\nMisconception and idealization of a past that never was",
			"styleAttributes":{},
			"x":-700,
			"y":-80,
			"width":260,
			"height":140
		},
		{
			"id":"8a8aabf36f9db1e3",
			"type":"text",
			"text":"Go full religion:\nDaryl turns to god and eventually is heard! The player for the first time doesn’t speak for Daryl, but to him!\n\nThis can imply two things: \n1 - you are the god who’s watching. The god outside the machine.\n2 - Or you are still Daryl, but disassociating from the self, to play your own god.",
			"styleAttributes":{},
			"x":-420,
			"y":-420,
			"width":260,
			"height":360
		},
		{
			"id":"2ce27da4a77388ad",
			"type":"text",
			"text":"-???-\n**Different time**\nSame god\nBurning books to keep warm\nMaintains the bunker\nGenerator give out\nDeep \nDrilling\nForgot\n\nTrapped in the abstract\n(Long term)",
			"styleAttributes":{},
			"x":-1540,
			"y":-420,
			"width":260,
			"height":300
		},
		{
			"id":"a8242abfcddbd51f",
			"type":"text",
			"text":"**Dad** - Digital alarming dosimeter",
			"styleAttributes":{},
			"x":-1540,
			"y":-100,
			"width":260,
			"height":60
		},
		{
			"id":"4f6f2b4c62bafc35",
			"type":"text",
			"text":"The game opens, with the end of days. \n(with the closing of the blast doors - neat! ^^)",
			"styleAttributes":{},
			"x":-1540,
			"y":-20,
			"width":260,
			"height":120
		},
		{
			"id":"0233bcf4712ac02f",
			"type":"text",
			"text":"Even simpler iwabo logline\nA narrative crpg about a family living in a bunker for ten years, but the world never ended.",
			"styleAttributes":{},
			"x":-1540,
			"y":120,
			"width":260,
			"height":120
		},
		{
			"id":"7e00e16852dfcb74",
			"type":"text",
			"text":"**Stewed eels Lyra**\nMake choice through execution of task?\n\nExpress inclination through whose advice you take \n\n  \n\nTwo benches, one full of bird shit",
			"styleAttributes":{},
			"x":-1540,
			"y":260,
			"width":260,
			"height":240
		},
		{
			"id":"22fc427be58a20f2",
			"type":"text",
			"text":"**Storyteller**\nAbility to tell great stories",
			"styleAttributes":{},
			"x":680,
			"y":-180,
			"width":260,
			"height":60
		},
		{
			"id":"7e50a73aa905894f",
			"type":"text",
			"text":"14.09.2024",
			"styleAttributes":{},
			"x":-1300,
			"y":520,
			"width":260,
			"height":60
		},
		{
			"id":"4208d0d3f574f5bf",
			"type":"text",
			"text":"26.06.2026",
			"styleAttributes":{},
			"x":-1300,
			"y":600,
			"width":260,
			"height":60
		},
		{
			"id":"60b7eaaaf717411f",
			"type":"text",
			"text":"18.04.2025 -> checkout",
			"styleAttributes":{},
			"x":-1320,
			"y":840,
			"width":260,
			"height":60
		},
		{
			"id":"6d0b97dec1d05221",
			"type":"text",
			"text":"06.07.2025",
			"styleAttributes":{},
			"x":-1300,
			"y":680,
			"width":260,
			"height":60
		},
		{
			"id":"852b20ab6d9051b7",
			"type":"text",
			"text":"06.97\n",
			"styleAttributes":{},
			"x":-1360,
			"y":740,
			"width":260,
			"height":60
		},
		{
			"id":"d18d8d9a419e71fb",
			"type":"text",
			"text":"07.03.2026",
			"styleAttributes":{},
			"x":-1320,
			"y":920,
			"width":260,
			"height":60
		},
		{
			"id":"338cdc1d232d60c0",
			"type":"text",
			"text":"misc",
			"styleAttributes":{},
			"x":-1380,
			"y":1020,
			"width":260,
			"height":60
		},
		{
			"id":"5ba6abf78db8713c",
			"type":"text",
			"text":"Weighted Dice - can manipulate all throws in your favour or against.",
			"styleAttributes":{},
			"x":1320,
			"y":-420,
			"width":260,
			"height":100
		},
		{
			"id":"724fa120ebc5d20b",
			"type":"text",
			"text":"**Make skill checks easier or harder by setting “goal “ with better or worse rewards.**",
			"styleAttributes":{},
			"x":400,
			"y":-420,
			"width":260,
			"height":100
		},
		{
			"id":"9b9a4ef591a31b18",
			"type":"text",
			"text":"These also rename/reframe the skills and may even be necessary to recognize/identify the harmful skills.\n\nThey may also allow you to level a skill straight beyond the threshold without it morphing.",
			"styleAttributes":{},
			"x":2280,
			"y":460,
			"width":260,
			"height":240
		},
		{
			"id":"167c01667fbdd7e8",
			"type":"text",
			"text":"Allowing players to loot ideas\n\nCould the second tension hook be understanding the self?\n\nOr is that just frustrating?\n\nTaking different perspectives and puzzling together the whole picture of how Daryl works, how to actually improve and be there for his family",
			"styleAttributes":{},
			"x":2280,
			"y":720,
			"width":260,
			"height":300
		},
		{
			"id":"2d2a38f7ae16807a",
			"type":"text",
			"text":"Perspectives",
			"styleAttributes":{},
			"x":2240,
			"y":-60,
			"width":260,
			"height":60
		},
		{
			"id":"975017a1babc54e1",
			"type":"text",
			"text":"Perspectives (thought cabinet)\nThe player can chose (or unlock through specific event outcomes) between perspectives, perhaps at massive skill changes as cost/benefit.",
			"styleAttributes":{},
			"x":2280,
			"y":20,
			"width":260,
			"height":200
		},
		{
			"id":"737f2b5de8c682b1",
			"type":"text",
			"text":"Possible perspectives:\n- Feminism (wave 1-4)\n- Gamer\n- Manosphere\n- Philosopher\n- Youth Pastor",
			"styleAttributes":{},
			"x":2280,
			"y":240,
			"width":260,
			"height":200
		},
		{
			"id":"f7e09100ff0c1b31",
			"type":"text",
			"text":"Mechanics",
			"styleAttributes":{},
			"x":1640,
			"y":-500,
			"width":260,
			"height":60
		},
		{
			"id":"606cd7d33e4f320b",
			"type":"text",
			"text":"Drugs and alcohol as a crutch when the going gets tough.",
			"styleAttributes":{},
			"x":1960,
			"y":-420,
			"width":260,
			"height":60
		},
		{
			"id":"82d6c1c031e5ce65",
			"type":"text",
			"text":"Have a photocamera/album",
			"styleAttributes":{},
			"x":2240,
			"y":-140,
			"width":260,
			"height":60
		},
		{
			"id":"0e88da403027ed99",
			"type":"text",
			"text":"Steal Hard-Coded progression?\n\nStory interaction passes the day\n\nActionpoints limit non-story interactions?",
			"styleAttributes":{},
			"x":2240,
			"y":1060,
			"width":260,
			"height":60
		},
		{
			"id":"cd98dd0ec1c4e1bf",
			"type":"text",
			"text":"Based on their opinion of you they bring you a pillow/blanket or fresh coffee when you collapse\n\nOr sit next to you, poking your face to wake you\n\nOr June tries to make coffee and makes a mess instead",
			"styleAttributes":{},
			"x":2240,
			"y":1140,
			"width":260,
			"height":260
		},
		{
			"id":"6cd83b9d0d1969e0",
			"type":"text",
			"text":"Walls closing in, letterboxing, the lower the mood",
			"styleAttributes":{},
			"x":-700,
			"y":-420,
			"width":260,
			"height":60
		},
		{
			"id":"96cbf7201f5e4bfa",
			"type":"text",
			"text":"Environment",
			"styleAttributes":{},
			"x":-1160,
			"y":-500,
			"width":260,
			"height":60
		},
		{
			"id":"5e9ef47ae898ce46",
			"type":"text",
			"text":"Silo the only place for a tree\nOr a trash heap",
			"styleAttributes":{},
			"x":-1100,
			"y":-420,
			"width":260,
			"height":80
		},
		{
			"id":"253f0f60fbde00b9",
			"type":"text",
			"text":"June disassembles something",
			"styleAttributes":{},
			"x":-1120,
			"y":-620,
			"width":260,
			"height":60
		},
		{
			"id":"ee5bae99844477a4",
			"type":"text",
			"text":"Daryl is Gay?\nEnjoys watching films with hot men more (higher mood buff)\n\nCan bring gay porn mag from outside",
			"styleAttributes":{},
			"x":2240,
			"y":-420,
			"width":260,
			"height":180
		},
		{
			"id":"77f89e1b4c969c41",
			"type":"text",
			"text":"Maybe to demonstrate relationship level?",
			"styleAttributes":{},
			"x":2240,
			"y":-220,
			"width":260,
			"height":60
		},
		{
			"id":"0a7b2a05af7e18f3",
			"type":"text",
			"text":"Quirks",
			"styleAttributes":{},
			"x":1260,
			"y":-500,
			"width":260,
			"height":60
		},
		{
			"id":"c7a03556a4237d2d",
			"type":"text",
			"text":"It doesn’t need to be perfect. It doesn’t even have to be right to work.\n\nIt just has to be meaningful",
			"styleAttributes":{},
			"x":560,
			"y":-780,
			"width":260,
			"height":160
		},
		{
			"id":"eef49cfa59ec1f0c",
			"type":"text",
			"text":"Traits",
			"styleAttributes":{},
			"x":360,
			"y":-500,
			"width":260,
			"height":60
		},
		{
			"id":"5152772184a615a8",
			"type":"text",
			"text":"Interrogate\n\n",
			"styleAttributes":{},
			"x":960,
			"y":-420,
			"width":260,
			"height":60
		},
		{
			"id":"6c22ef6813709ec7",
			"type":"text",
			"text":"UX",
			"styleAttributes":{},
			"x":-760,
			"y":-500,
			"width":260,
			"height":60
		},
		{
			"id":"49fa71902537efd9",
			"type":"text",
			"text":"He takes April hunting again, she needs to learn\n\nI don’t want to kill it\n\nYou cant afford to be that person if you want to survive with us.\n\nAnd you not surviving with us is not an option.",
			"styleAttributes":{},
			"x":-840,
			"y":-880,
			"width":260,
			"height":280
		},
		{
			"id":"7448ba66724fffc5",
			"type":"text",
			"text":"Much like Daryl spending loads of food and time on gym maxing, eventually the player notices Mary-Ann “letting herself go”. The player can accept or respect this, but also call it out. Which may lead to her becoming much less effective at everything else. Time and effort spent on looking good, that could be spent on maintenance and frankly - rest.",
			"styleAttributes":{},
			"x":-560,
			"y":-940,
			"width":260,
			"height":340
		},
		{
			"id":"92603f04b85dcdaf",
			"type":"text",
			"text":"Mary-Ann isn’t too happy with June reading about other religions. To her they’re more curiosities rather than “serious religion”",
			"styleAttributes":{},
			"x":-280,
			"y":-780,
			"width":260,
			"height":160
		},
		{
			"id":"45623c6d89d9d0c8",
			"type":"text",
			"text":"mary-ann breaks apils guitar",
			"styleAttributes":{},
			"x":-1120,
			"y":-700,
			"width":260,
			"height":60
		},
		{
			"id":"e8885cff8befa1b7",
			"type":"text",
			"text":"Masturbatory\n\nWhat’s wrong with masturbation? As long as I don’t expect people to ooh and aah at my brilliance. Besides, plenty of women have made good bank with that sort of thing in their bedrooms, so why shouldn’t in my study?\n\nWait, what do you know about women in bedrooms?\n\nWe did have the internet didn’t we?",
			"styleAttributes":{},
			"x":0,
			"y":-1060,
			"width":260,
			"height":400
		},
		{
			"id":"0a0e12ce48d643c0",
			"type":"text",
			"text":"Mary-Ann finds her faith once more or never finds god again but finds comfort in ritual",
			"styleAttributes":{},
			"x":280,
			"y":-740,
			"width":260,
			"height":100
		},
		{
			"id":"0d5d16ed44d8d821",
			"type":"text",
			"text":"Have April be the one who observes the fish spend their whole lives in a tank?\n\nUse it in a song?",
			"styleAttributes":{},
			"x":840,
			"y":-780,
			"width":260,
			"height":140
		},
		{
			"id":"533c92469780b7f5",
			"type":"text",
			"text":"June loses a Tooth",
			"styleAttributes":{},
			"x":280,
			"y":-820,
			"width":260,
			"height":60
		},
		{
			"id":"f7f09810e99753cb",
			"type":"text",
			"text":"Telling June Santa isnt real",
			"styleAttributes":{},
			"x":280,
			"y":-900,
			"width":260,
			"height":60
		},
		{
			"id":"e1fcf62eb3b704aa",
			"type":"text",
			"text":"Burning books to keep warm",
			"styleAttributes":{},
			"x":560,
			"y":-1000,
			"width":260,
			"height":60
		},
		{
			"id":"dd14a6720965ca97",
			"type":"text",
			"text":"example: \nforesight 49: check water supply for germs\n\nsuccess/failure: foresight++\n\n-> in this case the player would have to deal with paranoia until they got it all the way back down\n\nEven a good to very good reason would not be worth the extra hassle\n\nBut if the border were fuzzy or there was a chance the skill didn’t get increased, players might take that risk.",
			"styleAttributes":{},
			"x":2580,
			"y":-180,
			"width":260,
			"height":460
		},
		{
			"id":"42bc7f64d2db7c26",
			"type":"text",
			"text":"Traits",
			"styleAttributes":{},
			"x":2520,
			"y":-420,
			"width":260,
			"height":60
		},
		{
			"id":"cb206fd5773d287e",
			"type":"text",
			"text":"If we make it a clearly defined border/trip, and increase skills regardless of outcome, we might over incentivize players not to risk it.",
			"styleAttributes":{},
			"x":2580,
			"y":-340,
			"width":260,
			"height":140
		},
		{
			"id":"ad23a2b4d6dc5e21",
			"type":"text",
			"text":"Yelling at people doesn’t change their minds\nWhat else am I going to do?\nSo to feel good about yourself?\n\n",
			"styleAttributes":{},
			"x":560,
			"y":-920,
			"width":260,
			"height":120
		},
		{
			"id":"78ea4aff4e7751b6",
			"type":"text",
			"text":"Fridge Drawing\nLow perception -> no mood- -",
			"styleAttributes":{},
			"x":2580,
			"y":300,
			"width":260,
			"height":60
		},
		{
			"id":"3d122a8342ba6566",
			"type":"text",
			"text":"the drawing on the fridge",
			"styleAttributes":{},
			"x":840,
			"y":-1000,
			"width":260,
			"height":60
		},
		{
			"id":"5af0aab2cbc4f369",
			"type":"text",
			"text":"Fish out of Water",
			"styleAttributes":{},
			"x":1120,
			"y":-840,
			"width":260,
			"height":60
		},
		{
			"id":"e44cd969a488dac2",
			"type":"text",
			"text":"Why not sell the bunker?\n\nA lot of the games weight (actually not a lot, or at least not most, seeing that they will never get the years they lost back), hinges on them coming out of it with nothing, having left their house and everything behind. There are a few ways to attempt to fix this.\n\n  \n\n1 - when the attempt to sell it, the government or relatives of moneybags seize the property.\n\n  \n\n2 - selling it causes the cycle to continue. the only bidder is clearly planning to move his family there. And the characters decide against it because they dont want them to experience the same they do.\n\n  \n\n3 - they seal the bunker when they leave it\n\n  \n\n4 - they move back into the bunker, only coming out occasionally",
			"styleAttributes":{},
			"x":0,
			"y":-1480,
			"width":540,
			"height":400
		},
		{
			"id":"579440b55f9108fb",
			"type":"text",
			"text":"(Forgot) Wedding Anniversary",
			"styleAttributes":{},
			"x":280,
			"y":-980,
			"width":260,
			"height":60
		},
		{
			"id":"a14f0d67f73461cf",
			"type":"text",
			"text":"Forgot Junes Birthday",
			"styleAttributes":{},
			"x":280,
			"y":-1060,
			"width":260,
			"height":60
		},
		{
			"id":"dcc7933c60744547",
			"type":"text",
			"text":"Kids find /play with /hurt with gun",
			"styleAttributes":{},
			"x":560,
			"y":-1480,
			"width":260,
			"height":60
		},
		{
			"id":"07d257d18e1db964",
			"type":"text",
			"text":"The kids making breakfast",
			"styleAttributes":{},
			"x":560,
			"y":-1400,
			"width":260,
			"height":60
		},
		{
			"id":"643e3f3dc664fe2f",
			"type":"text",
			"text":"The kids making food (wasting!)",
			"styleAttributes":{},
			"x":560,
			"y":-1320,
			"width":260,
			"height":60
		},
		{
			"id":"4f6074d5a62370e0",
			"type":"text",
			"text":"June plays Restaurant",
			"styleAttributes":{},
			"x":560,
			"y":-1240,
			"width":260,
			"height":60
		},
		{
			"id":"a1f4b0341de449cd",
			"type":"text",
			"text":"**“This one goes on the fridge”**",
			"styleAttributes":{},
			"x":560,
			"y":-1160,
			"width":260,
			"height":60
		},
		{
			"id":"8a195788fb8424d5",
			"type":"text",
			"text":"Make npc call out Daryl being a sissy if female virtues?",
			"styleAttributes":{},
			"x":560,
			"y":-1080,
			"width":260,
			"height":60
		},
		{
			"id":"50c1bc16c7dc07e3",
			"type":"text",
			"text":"I like computers\nYou can just fix it if it misunderstands you\nPeople cling to the mistakes",
			"styleAttributes":{},
			"x":840,
			"y":-1480,
			"width":260,
			"height":120
		},
		{
			"id":"7f5b68656138bc53",
			"type":"text",
			"text":"When programming, take big ideas and break them down into small ones.\neasy to lose track of the big picture this way.",
			"styleAttributes":{},
			"x":840,
			"y":-1340,
			"width":260,
			"height":160
		},
		{
			"id":"16c045f453c75e04",
			"type":"text",
			"text":"petting fish",
			"styleAttributes":{},
			"x":840,
			"y":-1160,
			"width":260,
			"height":60
		},
		{
			"id":"76a37b33f2ad0e68",
			"type":"text",
			"text":"June playing guitar\nDaryl closing door",
			"styleAttributes":{},
			"x":840,
			"y":-1080,
			"width":260,
			"height":60
		},
		{
			"id":"ef8cc878d1c29f52",
			"type":"text",
			"text":"April does political art without consideration for context etc\n\nJune copies it",
			"styleAttributes":{},
			"x":840,
			"y":-920,
			"width":260,
			"height":120
		},
		{
			"id":"c6eeb1af6c9cdf33",
			"type":"text",
			"text":"April is an artist first, not a politician, so how can she be blamed for her work being misunderstood (even by herself, or even stemming from misunderstanding in the first place)?\n\nEven if politics was her bread and butter she would do political work first, not read political philosophy all day?\n\nSo is that the space for academics in society?\n\nHow then, as an artist or non-researcher can you minimise the risk of misinformation etc? Is the solution to say nothing?\n\nThat feels wrong but even if it wasn’t doesn’t seem like a realistically implementable solution",
			"styleAttributes":{},
			"x":1120,
			"y":-1480,
			"width":260,
			"height":620
		},
		{
			"id":"20c8996ce4c02912",
			"type":"text",
			"text":"**April gains weight**\nWhy do you care?\nFit for the apocalypse \nConserve food\n\nNot a fighter anyway\nNot even eating that much\n\nMeta: this child not \"good looking enough for you\"?",
			"styleAttributes":{},
			"x":1400,
			"y":-1480,
			"width":260,
			"height":260
		},
		{
			"id":"6aa73cbb48bb782d",
			"type":"text",
			"text":"(Protective custody)\n\n(Watching a movie where it comes up, why go to prison did nothing wrong, doesn’t just keep things in, keeps them out, sometimes only way to protect)\n\nBut why don’t they get a choice?\n\nFor their own good. Not always best judges for ourselves\n\nBut who gets to decide\n\nAuthority, family, science",
			"styleAttributes":{},
			"x":1400,
			"y":-1200,
			"width":260,
			"height":480
		},
		{
			"id":"acb9b4c29fb13831",
			"type":"text",
			"text":"June has a bad Dream\n-> bubble dream?",
			"styleAttributes":{},
			"x":1680,
			"y":-1480,
			"width":260,
			"height":60
		},
		{
			"id":"d12d2fb7f0dd2859",
			"type":"text",
			"text":"bc of scary movie?",
			"styleAttributes":{},
			"x":1680,
			"y":-1400,
			"width":260,
			"height":60
		},
		{
			"id":"7245e1b56a68efaa",
			"type":"text",
			"text":"**Mary-Ann the Bad Guy**\nshe feels left alone parenting with Daryl letting the kids get away with things.",
			"styleAttributes":{},
			"x":1680,
			"y":-1320,
			"width":260,
			"height":120
		},
		{
			"id":"22482fd1a94adbf7",
			"type":"text",
			"text":"Breaking Elysium",
			"styleAttributes":{},
			"x":280,
			"y":-1980,
			"width":260,
			"height":60
		},
		{
			"id":"d32a3bf35e8656eb",
			"type":"text",
			"text":"Narration is or can be interpreted by Daryl as god?\n\nIf enough faith Daryl has conversations with narration?\n\nDoes Daryl speak and the player answer or the player speak and narration answer?",
			"styleAttributes":{},
			"x":280,
			"y":-1900,
			"width":260,
			"height":220
		},
		{
			"id":"375afc4be3c45b52",
			"type":"text",
			"text":"FAMILY MATTERS MOST  \n\nWhat if, in trying to save your family, you are the one who hurt them most?\u0003\u0003  \nLoving dad who would do anything to protect his tribe, except question what that means.  \n\n-Daryl",
			"styleAttributes":{},
			"x":2540,
			"y":-1980,
			"width":260,
			"height":280
		},
		{
			"id":"66baae61e0a2e7b2",
			"type":"text",
			"text":"The only truly bad ending is the characters not addressing any of the issues between them but sticking together out of a feeling of obligation, being miserable.",
			"styleAttributes":{},
			"x":2260,
			"y":-1980,
			"width":260,
			"height":180
		},
		{
			"id":"78fb6399104e7ca9",
			"type":"text",
			"text":"**the hiker is a bit of a creep  \n**",
			"styleAttributes":{},
			"x":2260,
			"y":-1780,
			"width":260,
			"height":60
		},
		{
			"id":"d8071d760c1bb7cf",
			"type":"text",
			"text":"**April goes on a journey to discover other religions**",
			"styleAttributes":{},
			"x":-280,
			"y":-860,
			"width":260,
			"height":60
		},
		{
			"id":"96df3bb6fefac1d3",
			"type":"text",
			"text":"**April snaps out of it by telling off Maryann for letting herself go and Mary Ann retorting she’s doing the same thing. But she does so out of a feeing of superiority, and must later uplift ma as well to redeem this.**",
			"styleAttributes":{},
			"x":-280,
			"y":-1100,
			"width":260,
			"height":220
		},
		{
			"id":"46b9fc42fd967549",
			"type":"text",
			"text":"**You’re not going to win any awards with that one**\n\nOkay? Who cares?",
			"styleAttributes":{},
			"x":-560,
			"y":-1080,
			"width":260,
			"height":120
		},
		{
			"id":"533b340871aac769",
			"type":"text",
			"text":"Rushing to the bunker. Heavy storm to dead of night.",
			"styleAttributes":{},
			"x":-560,
			"y":-1160,
			"width":260,
			"height":60
		},
		{
			"id":"9abbe07391e3bf4a",
			"type":"text",
			"text":"Writing Style",
			"styleAttributes":{},
			"x":260,
			"y":-2060,
			"width":260,
			"height":60
		},
		{
			"id":"d29b7fc290c8add3",
			"type":"text",
			"text":"Story told from April's POV, in her Book?",
			"styleAttributes":{},
			"x":560,
			"y":-1980,
			"width":260,
			"height":60
		},
		{
			"id":"d1964a02791dd36b",
			"type":"text",
			"text":"**Omniscient narrator**",
			"styleAttributes":{},
			"x":560,
			"y":-1900,
			"width":260,
			"height":60
		},
		{
			"id":"cd3d5b20d9ecb8c2",
			"type":"text",
			"text":"focus, on making these small, sometimes funny, sometimes character driven interactions, surpris the player, but don't overdo it",
			"styleAttributes":{},
			"x":560,
			"y":-1820,
			"width":260,
			"height":160
		},
		{
			"id":"d022ab948cad31e3",
			"type":"text",
			"text":"Story",
			"styleAttributes":{},
			"x":2220,
			"y":-2060,
			"width":260,
			"height":60
		},
		{
			"id":"19b24aace5531d85",
			"type":"text",
			"text":"->cozy guitar girl family\n->apocalypse dad drama",
			"styleAttributes":{},
			"x":840,
			"y":-1980,
			"width":260,
			"height":60
		},
		{
			"id":"058433a186414683",
			"type":"text",
			"text":"Go full religion. Play baroque music preach from the pulpit that is the service stair to the second floor.",
			"styleAttributes":{},
			"x":-840,
			"y":-1020,
			"width":260,
			"height":120
		},
		{
			"id":"c834f24f09d65a50",
			"type":"text",
			"text":"June tries to carry a heavy food bucket and drops it. Do you try and scrape it back in? Accept the loss, scold her?",
			"styleAttributes":{},
			"x":-840,
			"y":-1160,
			"width":260,
			"height":120
		},
		{
			"id":"d2734bc25e601a19",
			"type":"text",
			"text":"April does the dust blow cave painting, using June as the model\n\nNaturally June is covered head to toe in dust\nYou find her, June laughing April looking ertappt\nHuge mess\n\nArt critic\n-> will notice the implication\nDo you commend the work?\nDo you shut it down?",
			"styleAttributes":{},
			"x":-280,
			"y":-1480,
			"width":260,
			"height":360
		},
		{
			"id":"9a651d3a97ffaebc",
			"type":"text",
			"text":"Runs out of Paint (starts using rations)",
			"styleAttributes":{},
			"x":-840,
			"y":-1240,
			"width":260,
			"height":60
		},
		{
			"id":"5da253915011c183",
			"type":"text",
			"text":"Already at the bunker?\n\nWatch the sun go down before locking yourself in.\n\nBirds flying low.\n\n  \n\nWaiting for the end? Sundown.",
			"styleAttributes":{},
			"x":-560,
			"y":-1360,
			"width":260,
			"height":120
		},
		{
			"id":"b1002a74d430f23a",
			"type":"text",
			"text":"Runs out of paper (starts painting on walls)",
			"styleAttributes":{},
			"x":-840,
			"y":-1320,
			"width":260,
			"height":60
		},
		{
			"id":"c35d16af55d4b6b6",
			"type":"text",
			"text":"Playing hide and seek; kid “too old”",
			"styleAttributes":{},
			"x":-840,
			"y":-1400,
			"width":260,
			"height":60
		},
		{
			"id":"3577b29cdaac3450",
			"type":"text",
			"text":"The Kids talk about what they would have been, had things been different.",
			"styleAttributes":{},
			"x":-560,
			"y":-1480,
			"width":260,
			"height":100
		},
		{
			"id":"1584922057b37837",
			"type":"text",
			"text":"Playing hide and seek kid goes where they shouldn’t",
			"styleAttributes":{},
			"x":-840,
			"y":-1480,
			"width":260,
			"height":60
		},
		{
			"id":"9666f2eb39f89177",
			"type":"text",
			"text":"POTENTIAL ISN’T ENOUGH \n\nHow do you love a child you blame for the life you never wanted-pushed to live your dream, and resented for succeeding?  \n\nChild prodigy turned housewife.  \n\n-Mary-Ann",
			"styleAttributes":{},
			"x":2820,
			"y":-1980,
			"width":260,
			"height":300
		},
		{
			"id":"f165a1c8f3cc6419",
			"type":"text",
			"text":"Reactivity",
			"styleAttributes":{},
			"x":2860,
			"y":-420,
			"width":260,
			"height":60
		},
		{
			"id":"6df4391e36ae2b18",
			"type":"text",
			"text":"Deal with pot branches by making optional scenes important by giving the player relevant information for choices down the line\n\nNot extra choices just better info on which is the best one\n\n  \n\nReactivity",
			"styleAttributes":{},
			"x":2920,
			"y":-340,
			"width":260,
			"height":260
		},
		{
			"id":"d5eb7fc73df1e968",
			"type":"text",
			"text":"I WON’T END LIKE HER\n\nWhat does the end of the world mean to an artist who spent her life creating for social recognition?\u0003\n\nSkilled artist with nothing to say.\n\n-April",
			"styleAttributes":{},
			"x":3100,
			"y":-1980,
			"width":260,
			"height":280
		},
		{
			"id":"68922570cf4354a6",
			"type":"text",
			"text":"BEING YOURSELF IS DANGEROUS\n\nHow do you choose between who people need you to be with who you are. Especially if you don’t seem to be good at being yourself?\u0003\n\nGifted mechanic, terrible artist. Trans - but can’t express it - yet.\n\n-June",
			"styleAttributes":{},
			"x":3380,
			"y":-1980,
			"width":260,
			"height":340
		},
		{
			"id":"74dc44db01a3bd31",
			"type":"text",
			"text":"Daryl accidentally reads Sodom and Gomorra story to kids and June is confused about or brings up in an uncomfortable way (without noticing, asking as kids do) the incest",
			"styleAttributes":{},
			"x":1680,
			"y":-1180,
			"width":260,
			"height":200
		},
